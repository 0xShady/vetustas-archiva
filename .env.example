# Contact email added to the Wikimedia User-Agent
CONTACT_EMAIL=

# Optional: override the ENTIRE User-Agent string. If set, it wins over
# CONTACT_EMAIL. (WIKIDATA_USER_AGENT is accepted as a legacy alias.)
USER_AGENT=

# TMDB API credentials, required by `npm run expand:tv`.
TMDB_APP_ID=
TMDB_APP_KEY=


# Last.fm API key, required by `npm run enrich:lastfm`.
LASTFM_API_KEY=
